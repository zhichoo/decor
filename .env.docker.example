# ./deploy.sh creates .env.docker with random passwords; never commit .env.docker.
# Keep generated database credentials unchanged after initialization.
POSTGRES_PASSWORD=GENERATE_ME
ADMIN_PASSWORD=GENERATE_ME
DECOR_PORT=4189
DECOR_PUBLIC_PORT=4190
DECOR_BIND=127.0.0.1
PUBLIC_READ_ONLY=false

# Each self-hosted instance uses its owner's API key and billing.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Manual transcripts work without ASR setup or a Douyin session.
TRANSCRIPT_PROVIDER=local_asr
LOCAL_ASR_THREADS=3
TRANSCRIPTGENERATE_TOKEN=
TRANSCRIPTGENERATE_EMAIL=
TRANSCRIPTGENERATE_PASSWORD=

# Optional published image; build locally with ./deploy.sh by default.
# DECOR_IMAGE=ghcr.io/zhichoo/decor:latest
